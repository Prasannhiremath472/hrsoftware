# Copy to `.env` in this folder before running the agent.

# Port for the local agent. Bound to 127.0.0.1 only — never exposed to the network.
AGENT_PORT=8891

# Origins allowed to call this agent (your web app). Comma-separated.
# Add your production domain here once deployed, e.g. https://yourdomain.com
AGENT_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5173

# Full path to the Mantra non-Aadhaar SDK DLL on this machine.
# Find this after installing the SDK — the filename varies by SDK version.
MANTRA_DLL_PATH=C:\Program Files\Mantra\MFS100\MFS100.dll

# Some SDK builds require a licence key at init; others read it from a file
# written by Mantra's activation tool. Leave blank if not required.
MANTRA_LICENCE_KEY=

# Template format the SDK produces. Confirm from the SDK docs.
# One of: ISO_19794_2 | ANSI_378 | PROPRIETARY
MANTRA_TEMPLATE_FORMAT=ISO_19794_2

# Recorded alongside captures for traceability.
MANTRA_SDK_VERSION=
