# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hrsoftware_user
DB_PASSWORD=change_me
DB_NAME=hrsoftware_kyc
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# File storage
UPLOAD_DIR=storage
MAX_FILE_SIZE_MB=10

# Biometric provider: mock | rdservice | vendor
#   mock      — simulated capture, no hardware needed (development/demo)
#   rdservice — real Aadhaar RD Service scanner (e.g. Mantra MFS110). The
#               device is USB-attached to the OPERATOR'S machine and its
#               driver listens on 127.0.0.1, so the browser/app performs the
#               capture and posts the result; the server stores only a
#               one-way hash + quality score, never the fingerprint.
#               Requires Mantra RD Service installed on each operator PC.
#   vendor    — placeholder for a direct native SDK integration (unimplemented)
BIOMETRIC_PROVIDER=mock

# --- Fingerprint templates (Mantra non-Aadhaar SDK path) --------------------
# Separate from BIOMETRIC_PROVIDER above. That path stores a proof-of-capture
# hash; this one stores real ISO templates for 1:1 verify and 1:N duplicate
# detection. Requires backend/database/migrations/002_fingerprint_templates.sql
# and the local agent in backend/biometric-agent/.
#
# Matcher used for template comparison:
#   exact     — byte-equality only. Detects a resubmitted identical template
#               and NOTHING else; two scans of the same finger differ, so this
#               will NOT catch real duplicates. Never false-positives. Default.
#   sdk_agent — delegates to a local agent running Mantra's own matcher
#               (accurate, but the agent must be reachable from the backend).
FINGERPRINT_MATCHER=exact

# Where the backend can reach a matcher agent when FINGERPRINT_MATCHER=sdk_agent.
FINGERPRINT_AGENT_URL=http://127.0.0.1:8891

# KYC provider: manual | provider
KYC_PROVIDER=manual

# Email (SMTP) — required for Super Admin OTP login in production.
# Works with any SMTP provider (Hostinger email, Gmail app password,
# SendGrid SMTP, etc). If left unset, the app falls back to logging the OTP
# to the server console — this fallback is DISABLED when NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin seeding (used by scripts/seedAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Super Admin

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
