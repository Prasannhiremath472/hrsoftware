# Copy this file to `.env` in the mobile/ project root before running the app.
# `.env` is loaded at startup via flutter_dotenv (see lib/core/config.dart).
#
# API_BASE_URL must point at the backend's /api prefix.
#
# Choose the value that matches how you're running the app:
#
#   Android emulator  -> http://10.0.2.2:5090/api
#     (10.0.2.2 is the emulator's alias for the host machine's localhost)
#
#   Physical Android/iOS device on the same Wi-Fi/LAN as your dev machine
#     -> http://<your-machine-LAN-IP>:5090/api
#     (e.g. http://192.168.1.23:5090/api — find your IP with `ipconfig` on
#     Windows; the backend's CORS_ORIGIN does not affect native HTTP clients,
#     only browser/web builds)
#
#   iOS simulator     -> http://localhost:5090/api
#     (the iOS simulator shares the host's network namespace)
#
#   flutter run -d chrome (web, for local verification only)
#     -> http://localhost:5090/api
#     (you may need to add this web origin, e.g. http://localhost:<port>,
#     to CORS_ORIGIN in backend/.env — browsers enforce CORS, native apps don't)

API_BASE_URL=http://10.0.2.2:5090/api
